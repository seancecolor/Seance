# Public MediaMTX LL-HLS base URL (no trailing slash)
PUBLIC_MEDIAMTX_HLS_ORIGIN=https://stream.visitantmedia.com
PUBLIC_MEDIAMTX_STREAM_PATH=cleanfeed

# Zoom App Client Secret (used to AES-GCM decrypt X-Zoom-App-Context)
ZOOM_CLIENT_SECRET=

# Secret for signing standalone browser / iPadOS room links (HMAC-SHA256)
ROOM_SIGNING_SECRET=dev_local_signing_secret_change_in_prod
