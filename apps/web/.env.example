# Private MediaMTX LL-HLS base URL (Railway internal network)
MEDIAMTX_INTERNAL_URL=http://mediamtx.railway.internal:8888
PUBLIC_MEDIAMTX_STREAM_PATH=cleanfeed

# Zoom App Client Secret (used to AES-GCM decrypt X-Zoom-App-Context)
ZOOM_CLIENT_SECRET=

# Secret for signing standalone browser / iPadOS room links & session cookies (HMAC-SHA256)
ROOM_SIGNING_SECRET=dev_local_signing_secret_change_in_prod

# Host passcode to unlock `/` directly as colorist (falls back to ROOM_SIGNING_SECRET if unset)
HOST_PASSCODE=
